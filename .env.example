# Shopify Storefront API.
#
# Required — the app throws at startup without them. On Vercel these must be
# set as BUILD environment variables: import.meta.env is inlined at build time,
# so a runtime-only value never reaches the bundle.
#
# The access token is a Storefront token, which is public by design (it ships in
# the client bundle). It is NOT an Admin API token — never put one of those here.
# Shopify admin -> Settings -> Apps and sales channels -> Develop apps.
VITE_SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN="your-storefront-access-token"

# Optional. Defaults to a current version; Shopify supports one for about a
# year, so bump deliberately rather than drifting.
VITE_SHOPIFY_API_VERSION="2026-07"

# Judge.me — powers the written reviews on product pages and the homepage
# testimonials wall. Both are optional: without them the product page still
# shows Shopify's aggregate rating, and the testimonials section hides itself
# rather than showing placeholder reviews.
#
# This token is PRIVATE. It is read via process.env in a server function and
# must never be given a VITE_ prefix, which would bundle it into the browser.
# Judge.me dashboard -> Settings -> API tokens.
# JUDGEME_API_TOKEN="your-judgeme-api-token"
# JUDGEME_SHOP_DOMAIN="your-store-domain"

# Contact form → Google Sheet. Setup: docs/contact-sheet.md
# The Apps Script web app URL (/exec) and the secret pasted into the script.
# CONTACT_SHEET_WEBHOOK_URL=
# CONTACT_SHEET_SECRET=
# Gate on /admin/contacts.csv. Unset = that route 404s. `openssl rand -hex 32`.
# CONTACT_EXPORT_TOKEN=
